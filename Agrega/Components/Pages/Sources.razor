@page "/sources"
@attribute [StreamRendering]


<PageTitle>Sources</PageTitle>

<h1>Sources</h1>

<p>This component loads your sources.</p>

@if (sourcesList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="sources-list">
        @foreach (var source in sourcesList)
        {
            <SourceItem Source="source" />
        }
    </div>
}


@code {
    private IEnumerable<Source> sourcesList = null!;

    protected override async Task OnInitializedAsync()
    {
        sourcesList = await Api.Sources.All();
    }
}
