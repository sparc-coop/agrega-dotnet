@page "/"
@attribute [StreamRendering]


<PageTitle>Agrega</PageTitle>

<h1>Agrega</h1>

<p>Centralize Your Reading, Simplify Your Browsing</p>

@if (posts == null)
{
    <p><em>Loading...</em></p>
}
else
{

    <div class="posts">
        @foreach (var post in posts)
        {
            <PostCard Post="post" />
        }
    </div>
}


@code {
    private IEnumerable<Post> posts = null!;

    protected override async Task OnInitializedAsync()
    {
        posts = await Api.Posts.Paginated(1,5);
    }

}
