    private async Task OpenSourceUrl()
    {
        await Post.AddView();
        var js = $"window.open('{Post.Url}', '_blank')";
        await jsRuntime.InvokeVoidAsync("eval", js);
    }

    private async Task SharePostUrl()
    {
        var textToShare = $"Stay updated with the latest .NET news! Check out this article: {Post.Url}. Shared via Agrega.NET";
        await jsRuntime.InvokeVoidAsync("copyToClipboard", textToShare);
        
    }

    private async Task SendMessage()
    {
        if (Hub == null)
        {
            Console.WriteLine("Hub is null");
            return;
        }

        await Hub.InvokeAsync("SendMessage", $"Hello from PostCard {Post.Id}");
    }

