@inherits BlossomRealtime

<div class="card">
    <img src="@(Post.ImgUrl ?? Post.SourceImage)" class="card-img-top" @onclick="() => OpenSourceUrl()">
    <div class="card-body">
        <h5 @onclick="() => OpenSourceUrl()" class="card-title">@Post.Title</h5>
        <small>@Post?.PostDate!.Value.ToShortDateString()</small> |
        <small>@(Post!.Views.HasValue ? Post.Views.Value : 0) view(s)</small>
        <p>(PostId) @Post.Id</p>
        <p>(ConnectionId) @Hub?.ConnectionId</p>
        <p>@lastMsg</p>
    </div>
    <div class="card-footer">
        <p>@Post.SourceName</p>
        <i class="bi-share" @onclick="SendMessage"></i>
        <div>
            <i class="bi-heart" @onclick="async () => await Post.AddLike()"></i> @(Post.Likes.HasValue ? Post.Likes.Value : 0)
        </div>
        <i class="@(Post.ReadLater.GetValueOrDefault() ? "bi-bookmark-dash-fill" : "bi-bookmark-plus")" @onclick="async () => await Post.ToggleReadLater()"></i>
    </div>
</div>

@using Microsoft.AspNetCore.SignalR.Client
