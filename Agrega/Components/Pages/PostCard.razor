@inherits BlossomRealtime

<div class="card">
    <img src="@(Post.ImgUrl ?? Post.SourceImage)" class="card-img-top" @onclick="() => OpenSourceUrl()">
    <div class="card-body">
        <h5 @onclick="() => OpenSourceUrl()" class="card-title">@Post.Title</h5>
        <small>@Post?.PostDate!.Value.ToShortDateString()</small> |
        <small>@(Post!.Views.HasValue ? Post.Views.Value : 0) view(s)</small>
    </div>
    <div class="card-footer">
        <p>@Post.SourceName</p>
        <i class="bi-share" @onclick="SharePostUrl"></i>
        <div>
            <i class="bi-heart" @onclick="async () => await Post.AddLike()"></i> @(Post.Likes.HasValue ? Post.Likes.Value : 0)
        </div>
        <i class="@(Post.ReadLater.GetValueOrDefault() ? "bi-bookmark-dash-fill" : "bi-bookmark-plus")" @onclick="async () => await Post.ToggleReadLater()"></i>
    </div>
</div>

@code {
    [Parameter]
    public Post Post { get; set; }

    private async Task OpenSourceUrl()
    {
        await Post.AddView();
        var js = $"window.open('{Post.Url}', '_blank')";
        await jsRuntime.InvokeVoidAsync("eval", js);
    }

    private async Task SharePostUrl()
    {
        var textToShare = $"Stay updated with the latest .NET news! Check out this article: {Post.Url}. Shared via Agrega";
        await jsRuntime.InvokeVoidAsync("copyToClipboard", textToShare);
        
    }
}
