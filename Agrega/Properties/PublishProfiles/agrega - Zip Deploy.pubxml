<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://agrega.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ProjectGuid>8fac2a64-e9e2-4a79-909f-5b614fad9e69</ProjectGuid>
    <PublishUrl>https://agrega.scm.azurewebsites.net/</PublishUrl>
    <UserName>$agrega</UserName>
    <_SavePWD>true</_SavePWD>
  </PropertyGroup>
</Project>